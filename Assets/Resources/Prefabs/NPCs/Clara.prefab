  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25a98cb3857bdae43814b27182482d56, type: 3}
  m_Name: 
  m_EditorClassIdentifier: SowurShield.Runtime::SowurShield.Dialogue.NPCDialogueInteractable
  npcId: clara
  npcDisplayName: Clara
  npcPortrait: {fileID: 21300000, guid: 49f4dc36b93d5044d9a208d1934a9d63, type: 3}
  npcBioLocalized:
    m_TableReference:
      m_TableCollectionName: Dialogue
    m_TableEntryReference:
      m_KeyId: 14950889742393344
      m_Key: 
    m_FallbackState: 0
    m_WaitForCompletion: 0
    m_LocalVariables: []
  npcBio: Herborista. Sabe o nome de todas as plantas e a serventia de quase todas.
  availableDialogues:
  - {fileID: 11400000, guid: 51644b6ef8f5f4c4294517546c4c9dc0, type: 2}
  defaultDialogue: {fileID: 11400000, guid: 51644b6ef8f5f4c4294517546c4c9dc0, type: 2}
  interactionPrompt: {fileID: 6712512050850793998}
  dialogueBox: {fileID: 0}
  interactionRange: 3
  allowRepeatedConversations: 1
  cooldownBetweenInteractions: 1
  disableMovementDuringDialogue: 1
  enableGifting: 1
  enableSeedShop: 0
  shopData: {fileID: 11400000, guid: ba45dab9dcb29f1479a8735afa597ab9, type: 2}
  loreEntries:
  - requiredRelationship: 0
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889742393345
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: "Quem \xE9 Clara?"
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889742393346
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "A herborista. Se voc\xEA adoecer no vale, \xE9 a porta dela que voc\xEA
      bate."
  - requiredRelationship: 10
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889742393347
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: O Jardim
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889742393348
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "O jardim dela parece bagun\xE7ado, mas cada planta est\xE1 exatamente
      onde ela quer."
  - requiredRelationship: 40
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889746587648
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: A Aprendiz
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889746587649
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Aprendeu com uma velha que morava na floresta e nunca teve nome, s\xF3
      apelido."
  - requiredRelationship: 75
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889750781952
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: A Planta que Falta
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889750781953
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Procura h\xE1 anos uma erva que s\xF3 viu uma vez, quando crian\xE7a.
      N\xE3o sabe se existiu mesmo."
  lovedGifts:
  - MysterySeed
