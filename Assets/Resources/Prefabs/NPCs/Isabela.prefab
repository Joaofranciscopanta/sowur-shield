--- !u!114 &4717702987233552855
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1047477700179356746}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25a98cb3857bdae43814b27182482d56, type: 3}
  m_Name: 
  m_EditorClassIdentifier: SowurShield.Runtime::SowurShield.Dialogue.NPCDialogueInteractable
  npcId: isabela
  npcDisplayName: Isabela
  npcPortrait: {fileID: 21300000, guid: a81031c64c36bde41904cf52b7031186, type: 3}
  npcBioLocalized:
    m_TableReference:
      m_TableCollectionName: Dialogue
    m_TableEntryReference:
      m_KeyId: 14950889729810432
      m_Key: 
    m_FallbackState: 0
    m_WaitForCompletion: 0
    m_LocalVariables: []
  npcBio: "Padeira. Acorda \xE0s quatro da manh\xE3 e jura que o cheiro do p\xE3o
    \xE9 melhor que o gosto."
  availableDialogues:
  - {fileID: 11400000, guid: a63bc588d1f974b4a995aaeb055b3560, type: 2}
  defaultDialogue: {fileID: 11400000, guid: a63bc588d1f974b4a995aaeb055b3560, type: 2}
  interactionPrompt: {fileID: 2132137206348801265}
  dialogueBox: {fileID: 0}
  interactionRange: 1.5
  allowRepeatedConversations: 1
  cooldownBetweenInteractions: 1
  disableMovementDuringDialogue: 1
  enableGifting: 1
  enableSeedShop: 0
  shopData: {fileID: 11400000, guid: 5980d35840475ef488c0c7050b372c1e, type: 2}
  loreEntries:
  - requiredRelationship: 0
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889729810433
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: "Quem \xE9 Isabela?"
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889729810434
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: A padeira do vale. O forno dela acende antes do sol.
  - requiredRelationship: 10
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889729810435
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: A Receita
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889729810436
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Ela usa a receita da av\xF3, mas mudou uma coisa e n\xE3o conta qual."
  - requiredRelationship: 40
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889729810437
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: "O Inverno Dif\xEDcil"
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889729810438
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Num inverno em que faltou farinha, ela assou p\xE3o para o vale inteiro
      com o que tinha guardado para si."
  - requiredRelationship: 75
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889729810439
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: O Caderno
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889734004736
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Guarda um caderno de receitas que ningu\xE9m nunca leu. Diz que metade
      delas nunca deu certo."
  lovedGifts:
  - Egg
  - Milk
  likedGifts:
  - Pumpkin
  - Carrot
  - Apple
  dislikedGifts:
  - Rabbit Fur
  dailyTalkAffinity: 1
  interactionSound: {fileID: 0}
  audioSource: {fileID: 0}
  references:
