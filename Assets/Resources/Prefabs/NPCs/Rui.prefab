--- !u!114 &4145993846674201188
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5983520364583961867}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25a98cb3857bdae43814b27182482d56, type: 3}
  m_Name: 
  m_EditorClassIdentifier: SowurShield.Runtime::SowurShield.Dialogue.NPCDialogueInteractable
  npcId: rui
  npcDisplayName: Rui
  npcPortrait: {fileID: 21300000, guid: 82fa96444ab9afe4097155c99c176944, type: 3}
  npcBioLocalized:
    m_TableReference:
      m_TableCollectionName: Dialogue
    m_TableEntryReference:
      m_KeyId: 14950889700450312
      m_Key: 
    m_FallbackState: 0
    m_WaitForCompletion: 0
    m_LocalVariables: []
  npcBio: "Carpinteiro. Mede tr\xEAs vezes, corta uma, e reclama de quem faz diferente."
  availableDialogues:
  - {fileID: 11400000, guid: 91f35461049655b4f8f693323b2c2aa0, type: 2}
  defaultDialogue: {fileID: 11400000, guid: 91f35461049655b4f8f693323b2c2aa0, type: 2}
  interactionPrompt: {fileID: 714631164724455623}
  dialogueBox: {fileID: 0}
  interactionRange: 1.5
  allowRepeatedConversations: 1
  cooldownBetweenInteractions: 1
  disableMovementDuringDialogue: 1
  enableGifting: 1
  enableSeedShop: 0
  shopData: {fileID: 11400000, guid: d7c918a57ca7bd34386739975cd4e4a6, type: 2}
  loreEntries:
  - requiredRelationship: 0
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889700450313
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: "Quem \xE9 Rui?"
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889700450314
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: O carpinteiro. Construiu metade dos telhados do vale.
  - requiredRelationship: 10
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889700450315
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: A Madeira
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889704644608
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Ele escolhe a madeira batendo nela e ouvindo. Diz que cada \xE1rvore soa
      diferente."
  - requiredRelationship: 40
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889708838912
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: A Casa Torta
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889708838913
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "A primeira casa que construiu saiu torta. Ela ainda est\xE1 de p\xE9,
      e ele ainda tem vergonha."
  - requiredRelationship: 75
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889708838914
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: "O Ber\xE7o"
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889713033216
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Guarda um ber\xE7o que fez para um filho que n\xE3o chegou a nascer. Nunca
      conseguiu desmontar."
  lovedGifts:
  - Wood
  likedGifts:
  - Bread
  - Apple
  - Banana
  dislikedGifts:
  - Rabbit Fur
  dailyTalkAffinity: 1
  interactionSound: {fileID: 0}
