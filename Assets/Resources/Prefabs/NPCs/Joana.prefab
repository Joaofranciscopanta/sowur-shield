--- !u!114 &7915188389842776462
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6839625654263667775}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25a98cb3857bdae43814b27182482d56, type: 3}
  m_Name: 
  m_EditorClassIdentifier: SowurShield.Runtime::SowurShield.Dialogue.NPCDialogueInteractable
  npcId: joana
  npcDisplayName: Joana
  npcPortrait: {fileID: 21300000, guid: f77d08297be71ab40a8c67f994ede80c, type: 3}
  npcBioLocalized:
    m_TableReference:
      m_TableCollectionName: Dialogue
    m_TableEntryReference:
      m_KeyId: 14950889738199040
      m_Key: 
    m_FallbackState: 0
    m_WaitForCompletion: 0
    m_LocalVariables: []
  npcBio: Pescadora. Passa mais tempo no rio que em casa e considera isso perfeitamente
    normal.
  availableDialogues:
  - {fileID: 11400000, guid: c82572ad998b6eb41aab6292c9cb4b9b, type: 2}
  defaultDialogue: {fileID: 11400000, guid: c82572ad998b6eb41aab6292c9cb4b9b, type: 2}
  interactionPrompt: {fileID: 5203109237577409368}
  dialogueBox: {fileID: 0}
  interactionRange: 3
  allowRepeatedConversations: 1
  cooldownBetweenInteractions: 1
  disableMovementDuringDialogue: 1
  enableGifting: 1
  enableSeedShop: 0
  shopData: {fileID: 0}
  loreEntries:
  - requiredRelationship: 0
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889738199041
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: "Quem \xE9 Joana?"
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889738199042
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "A pescadora. Conhece cada curva do rio pelo som da \xE1gua."
  - requiredRelationship: 10
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889738199043
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: O Rio
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889738199044
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Ela diz que o rio muda de humor com as esta\xE7\xF5es, e que d\xE1 para
      ouvir."
  - requiredRelationship: 40
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889738199045
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: O Peixe que Escapou
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889738199046
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Fala de um peixe enorme que escapou dela h\xE1 dez anos. Ningu\xE9m sabe
      se \xE9 verdade."
  - requiredRelationship: 75
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889738199047
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: O Barco do Pai
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889738199048
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "O barco que ela usa era do pai. J\xE1 trocou cada t\xE1bua, mas insiste
      que \xE9 o mesmo barco."
  lovedGifts:
  - RareFish
  - Fish
  likedGifts:
  - Bread
  - Radish
  dislikedGifts:
  - Wood
  dailyTalkAffinity: 1
  interactionSound: {fileID: 0}
  audioSource: {fileID: 0}
  references:
    version: 2
    RefIds: []
