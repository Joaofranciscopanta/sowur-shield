--- !u!114 &4136886525839681995
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3970493149517219151}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25a98cb3857bdae43814b27182482d56, type: 3}
  m_Name: 
  m_EditorClassIdentifier: SowurShield.Runtime::SowurShield.Dialogue.NPCDialogueInteractable
  npcId: tomas
  npcDisplayName: "Tom\xE1s"
  npcPortrait: {fileID: 21300000, guid: bbdf885e61d84944b8caed23f19ea260, type: 3}
  npcBioLocalized:
    m_TableReference:
      m_TableCollectionName: Dialogue
    m_TableEntryReference:
      m_KeyId: 14950889520095232
      m_Key: 
    m_FallbackState: 0
    m_WaitForCompletion: 0
    m_LocalVariables: []
  npcBio: "O ferreiro do vale. Fala pouco, martela muito. Diz que metal honesto n\xE3o
    mente."
  availableDialogues:
  - {fileID: 11400000, guid: bfbb495fae1114345bbc9bf9c2b0d1b5, type: 2}
  defaultDialogue: {fileID: 11400000, guid: bfbb495fae1114345bbc9bf9c2b0d1b5, type: 2}
  interactionPrompt: {fileID: 8280619779492155794}
  dialogueBox: {fileID: 0}
  interactionRange: 3
  allowRepeatedConversations: 1
  cooldownBetweenInteractions: 1
  disableMovementDuringDialogue: 1
  enableGifting: 1
  enableSeedShop: 0
  shopData: {fileID: 11400000, guid: 6ae688b2b68a78842ae783e4dfae53ef, type: 2}
  loreEntries:
  - requiredRelationship: 0
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889666895872
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: "Quem \xE9 Tom\xE1s?"
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889666895873
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "O ferreiro. Aprendeu o of\xEDcio com o av\xF4 e nunca saiu do vale."
  - requiredRelationship: 10
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889671090176
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: A Forja
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889671090177
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "A forja dele \xE9 a mais antiga do vale. O fogo nunca apagou completamente
      em quarenta anos."
  - requiredRelationship: 40
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889675284480
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: "As M\xE3os"
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889675284481
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "As cicatrizes nas m\xE3os dele contam cada erro que cometeu aprendendo.
      Ele diz que s\xE3o o diploma dele."
  - requiredRelationship: 75
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889679478784
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: O Sino
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889679478785
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Tom\xE1s fundiu o sino da pra\xE7a quando tinha vinte anos. Toda vez que
      toca, ele para o que est\xE1 fazendo e escuta."
  lovedGifts:
  - Wood
  - RareFish
  likedGifts:
  - Bread
  - Milk
  dislikedGifts:
  - Feather
  dailyTalkAffinity: 1
  interactionSound: {fileID: 0}
  audioSource: {fileID: 0}
  references:
    version: 2
    RefIds: []
