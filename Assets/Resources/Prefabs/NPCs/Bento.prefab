--- !u!114 &3498914601108310297
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7250638884429347521}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 25a98cb3857bdae43814b27182482d56, type: 3}
  m_Name: 
  m_EditorClassIdentifier: SowurShield.Runtime::SowurShield.Dialogue.NPCDialogueInteractable
  npcId: bento
  npcDisplayName: Bento
  npcPortrait: {fileID: 21300000, guid: 47686aac9b783a040854c54813fce514, type: 3}
  npcBioLocalized:
    m_TableReference:
      m_TableCollectionName: Dialogue
    m_TableEntryReference:
      m_KeyId: 14950889683673088
      m_Key: 
    m_FallbackState: 0
    m_WaitForCompletion: 0
    m_LocalVariables: []
  npcBio: "O mais velho do vale. Senta na pra\xE7a e comenta tudo que passa."
  availableDialogues:
  - {fileID: 11400000, guid: d7fe0afdaff45504d867f18dd2d105ea, type: 2}
  defaultDialogue: {fileID: 11400000, guid: d7fe0afdaff45504d867f18dd2d105ea, type: 2}
  interactionPrompt: {fileID: 8483114683023208713}
  dialogueBox: {fileID: 0}
  interactionRange: 3
  allowRepeatedConversations: 1
  cooldownBetweenInteractions: 1
  disableMovementDuringDialogue: 1
  enableGifting: 1
  enableSeedShop: 0
  shopData: {fileID: 0}
  loreEntries:
  - requiredRelationship: 0
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889683673089
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: "Quem \xE9 Bento?"
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889683673090
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "O mais velho daqui. Viu o vale mudar tr\xEAs vezes."
  - requiredRelationship: 10
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889687867392
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: "As Hist\xF3rias"
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889687867393
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "Conta a mesma hist\xF3ria de jeitos diferentes, e todas as vers\xF5es
      s\xE3o boas."
  - requiredRelationship: 40
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889687867394
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: O Que Ele Viu
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889692061696
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: Estava aqui quando o vale quase secou. Diz que a terra se lembra disso.
  - requiredRelationship: 75
    titleLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889696256000
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    title: O Banco
    bodyLocalized:
      m_TableReference:
        m_TableCollectionName: Dialogue
      m_TableEntryReference:
        m_KeyId: 14950889696256001
        m_Key: 
      m_FallbackState: 0
      m_WaitForCompletion: 0
      m_LocalVariables: []
    body: "O banco onde ele senta foi feito pelo pai dele. \xC9 o \xFAltimo peda\xE7o
      que restou da casa antiga."
  lovedGifts:
  - Bread
  - Milk
  likedGifts:
  - Apple
  - Pumpkin
  - Egg
  dislikedGifts:
  - MysterySeed
  dailyTalkAffinity: 1
  interactionSound: {fileID: 0}
  audioSource: {fileID: 0}
  references:
    version: 2
    RefIds: []
