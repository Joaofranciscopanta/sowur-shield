  m_Script: {fileID: 11500000, guid: b9b5041c652cccf43bbd575d56fe419f, type: 3}
  m_Name: Maren_Beloved
  m_EditorClassIdentifier: SowurShield.Dialogue.DialogueTree
  conversationId: maren_beloved
  conversationDescription: "Unlocked at relationship >= 75. Maren reveals her secret — she keeps a special seed she has never dared to plant."
  startNodeId: start
  isRepeatable: 1
  saveProgressOnExit: 1
  nodes:
  - nodeId: start
    speakerName: Maren
    speakerEmotion: 7
    speakerPosition: 0
    dialogueText: "I trust you more than anyone in this valley. There's something I want to show you."
    nodeType: 0
    choices: []
    nextNodeId: secret_seed
    autoAdvanceDelay: 0
    displayConditions:
    - conditionType: 3
      conditionKey: maren
      conditionOperator: 4
      conditionValue: "75"
      invertCondition: 0
      description: "Beloved tier"
    nodeEffects: []
  - nodeId: secret_seed
    speakerName: Maren
    speakerEmotion: 7
    speakerPosition: 0
    dialogueText: "This seed... I found it in my father's coat pocket the day he died. I never knew what plant it was. I never had the courage to plant it — what if I lost the last thing I have left of him?"
    nodeType: 0
    choices:
    - choiceText: "You should plant it. It's what he would have wanted."
      nextNodeId: encourage_plant
      requirements: []
      effects:
      - effectType: 1
        effectKey: maren
        effectValue: ""
        numericValue: 5
        description: "+5 relationship for sincere encouragement"
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "You don't have to plant it. Keep it as a memory."
      nextNodeId: keep_memory
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: encourage_plant
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Maybe you're right. He loved watching things grow. When I have the courage, you'll be the first to know. Thank you... truly."
    nodeType: 0
    choices: []
    nextNodeId: gift_reward
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects:
    - effectType: 0
      effectKey: maren_encouraged_seed
      effectValue: "true"
      numericValue: 0
      description: "Flag: player encouraged Maren to plant her father's seed"
  - nodeId: keep_memory
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "You're... right too. Some things are better kept in the heart. But it's good to be able to talk about it with someone."
    nodeType: 0
    choices: []
    nextNodeId: gift_reward
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: gift_reward
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Accept this as a gift. I always keep a special batch of seeds for the day I find someone I can trust. That day has come."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects:
    - effectType: 3
      effectKey: PumpkinSeed
      effectValue: ""
      numericValue: 3
      description: "Gives 3x Pumpkin Seeds as a trust reward"
    - effectType: 0
      effectKey: maren_gave_gift_seeds
      effectValue: "true"
      numericValue: 0
      description: "Flag: reward already given, prevents second delivery"
  tags:
  - beloved
  - lore
  - secret
  priority: 20
