MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9b5041c652cccf43bbd575d56fe419f, type: 3}
  m_Name: Maren_Friend
  m_EditorClassIdentifier: SowurShield.Dialogue.DialogueTree
  conversationId: maren_friend
  conversationDescription: "Dialogue unlocked when relationship >= 40. Maren opens up about her past and her reason for settling here."
  startNodeId: start
  isRepeatable: 1
  saveProgressOnExit: 1
  nodes:
  - nodeId: start
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Ah, you again! You know, few people bother to stop and talk. I'm glad you're different."
    nodeType: 0
    choices: []
    nextNodeId: lore_reveal
    autoAdvanceDelay: 0
    displayConditions:
    - conditionType: 2
      conditionKey: maren
      conditionOperator: 2
      conditionValue: "40"
      invertCondition: 0
      description: "Only shows if relationship >= 40"
    nodeEffects: []
  - nodeId: lore_reveal
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "I ended up here after a drought that destroyed everything I planted in the eastern valley. I lost three harvests in a row. But the soil here... it received me differently."
    nodeType: 0
    choices:
    - choiceText: "What's so special about this soil?"
      nextNodeId: lore_soil
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Didn't you feel like giving up?"
      nextNodeId: lore_persevere
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: lore_soil
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "There's something in the roots here, in the deepest layers. They say an ancient druid blessed the entire valley. I don't know if I believe in stories, but the plants grow too fast to just be luck."
    nodeType: 0
    choices: []
    nextNodeId: lore_gift_hint
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: lore_persevere
    speakerName: Maren
    speakerEmotion: 2
    speakerPosition: 0
    dialogueText: "Many times. But my mother always said: the seed that survives winter blooms stronger. I ended up believing it."
    nodeType: 0
    choices: []
    nextNodeId: lore_gift_hint
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: lore_gift_hint
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "If you treat the land well, it gives back. Take care of your beds' fertility — tired soil gives less. Natural fertilizers help, but what works best is not rushing the process."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects:
    - effectType: 0
      effectKey: maren_shared_lore
      effectValue: "true"
      numericValue: 0
      description: "Marks that Maren already shared the fertility lore"
  tags:
  - friend
  - lore
  priority: 10
