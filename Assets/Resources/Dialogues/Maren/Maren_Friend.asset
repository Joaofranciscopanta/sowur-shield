%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9b5041c652cccf43bbd575d56fe419f, type: 3}
  m_Name: Maren_Friend
  m_EditorClassIdentifier: SowurShield.Dialogue.DialogueTree
  conversationId: maren_friend
  conversationDescription: "Dialogue unlocked when relationship >= 40. Maren opens
    up about her past and her reason for settling here."
  startNodeId: start
  isRepeatable: 1
  saveProgressOnExit: 1
  nodes:
  - nodeId: start
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Ah, voce de novo! Sabe, poucos se preocupam em parar e conversar.
      Fico feliz que seja diferente."
    nodeType: 0
    choices: []
    nextNodeId: lore_reveal
    autoAdvanceDelay: 0
    displayConditions:
    - conditionType: 2
      conditionKey: maren
      conditionOperator: 2
      conditionValue: "40"
      invertCondition: 0
      description: "So exibe se relacionamento >= 40"
    nodeEffects: []
  - nodeId: lore_reveal
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "Vim parar aqui depois de uma seca que destruiu tudo que plantei
      no vale leste. Perdi tres colheitas seguidas. Mas a terra aqui... ela me
      recebeu de um jeito diferente."
    nodeType: 0
    choices:
    - choiceText: "O que tem de especial nesta terra?"
      nextNodeId: lore_soil
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Voce nao sentiu vontade de desistir?"
      nextNodeId: lore_persevere
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: lore_soil
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Ha algo nas raizes aqui, nas camadas mais fundas. Dizem que um
      druida antigo abencou o vale inteiro. Nao sei se acredito em historias,
      mas as plantas crescem rapido demais para ser so sorte."
    nodeType: 0
    choices: []
    nextNodeId: lore_gift_hint
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: lore_persevere
    speakerName: Maren
    speakerEmotion: 2
    speakerPosition: 0
    dialogueText: "Muitas vezes. Mas minha mae sempre dizia: a semente que sobrevive
      ao inverno floresce mais forte. Acabei acreditando."
    nodeType: 0
    choices: []
    nextNodeId: lore_gift_hint
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: lore_gift_hint
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "Se voce tratar bem a terra, ela retribui. Cuide da fertilidade
      dos seus canteiros — o solo cansado da menos. Abubos naturais ajudam,
      mas o que mais funciona e nao apressar o processo."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects:
    - effectType: 0
      effectKey: maren_shared_lore
      effectValue: "true"
      numericValue: 0
      description: "Marca que Maren ja compartilhou o lore da fertilidade"
  tags:
  - friend
  - lore
  priority: 10
