%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b9b5041c652cccf43bbd575d56fe419f, type: 3}
  m_Name: Maren_Default
  m_EditorClassIdentifier: SowurShield.Dialogue.DialogueTree
  conversationId: maren_default
  conversationDescription: "Maren's everyday greeting with topic choices that unlock
    more lore as relationship grows."
  startNodeId: start
  isRepeatable: 1
  saveProgressOnExit: 1
  nodes:
  - nodeId: start
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Bom dia! Os canteiros estao chamando. O que posso fazer por voce?"
    nodeType: 0
    choices:
    - choiceText: "Fale sobre voce mesma."
      nextNodeId: topic_about
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "O que voce acha deste vale?"
      nextNodeId: topic_valley
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Me da uma dica de plantio."
      nextNodeId: topic_tip
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "O que voce guarda de tao especial?"
      nextNodeId: topic_secret
      requirements:
      - conditionType: 2
        conditionKey: maren
        conditionOperator: 2
        conditionValue: "40"
        invertCondition: 0
        description: "Disponivel somente com rel >= 40"
      effects: []
      isExitChoice: 0
      choiceColor: {r: 0.9, g: 0.85, b: 0.5, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []

  # ---- TOPIC: sobre si mesma ----
  - nodeId: topic_about
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "Sou filha de agricultores do vale leste. Aprendi a plantar antes
      de aprender a escrever. Mas a seca nao perdoa ninguem — vim parar aqui depois
      de perder tudo."
    nodeType: 0
    choices:
    - choiceText: "Deve ter sido dificil recomecar."
      nextNodeId: about_restart
      requirements: []
      effects:
      - effectType: 1
        effectKey: maren
        effectValue: ""
        numericValue: 2
        description: "+2 por empatia"
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Voce se adaptou bem."
      nextNodeId: about_adapted
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []

  - nodeId: about_restart
    speakerName: Maren
    speakerEmotion: 2
    speakerPosition: 0
    dialogueText: "Foi. Mas a terra aqui tem algo de especial. Me acolheu de um
      jeito que o vale leste nunca fez. Talvez seja isso que chamo de lar agora."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []

  - nodeId: about_adapted
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Demorei um pouco. Cada solo e diferente — tem suas manias. Mas
      aprendi a ouvir o que a terra me pede."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []

  # ---- TOPIC: sobre o vale ----
  - nodeId: topic_valley
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "Este vale tem historia. As pessoas vem, plantam, colhem e vao embora.
      Poucos ficam. Algo aqui te prende — a terra, o ritmo das estacoes, nao sei."
    nodeType: 0
    choices:
    - choiceText: "Ha algo de mistico nesta terra?"
      nextNodeId: valley_mystic
      requirements:
      - conditionType: 2
        conditionKey: maren
        conditionOperator: 2
        conditionValue: "10"
        invertCondition: 0
        description: "So aparece com rel >= 10 (Friend+)"
      effects: []
      isExitChoice: 0
      choiceColor: {r: 0.85, g: 0.95, b: 1, a: 1}
    - choiceText: "Eu entendo essa sensacao."
      nextNodeId: valley_feel
      requirements: []
      effects:
      - effectType: 1
        effectKey: maren
        effectValue: ""
        numericValue: 1
        description: "+1 por concordar"
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []

  - nodeId: valley_mystic
    speakerName: Maren
    speakerEmotion: 5
    speakerPosition: 0
    dialogueText: "Dizem que um druida abencou as camadas mais fundas do solo aqui.
      Nao sei se acredito, mas as plantas crescem rapido demais pra ser so clima.
      Cuide bem da fertilidade dos seus canteiros — ela e mais valiosa do que parece."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects:
    - effectType: 0
      effectKey: maren_told_valley_lore
      effectValue: "true"
      numericValue: 0
      description: "Flag: jogador soube do lore do druida"

  - nodeId: valley_feel
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Bom. Significa que voce veio pra ficar. As melhores colheitas sao
      de quem planta com intencao."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []

  # ---- TOPIC: dica de plantio ----
  - nodeId: topic_tip
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Dica do dia: o solo cansa. Cada colheita tira um pouco da fertilidade.
      Quanto menos fertil, menos voce colhe. Deixe o solo descansar ou use adubo
      — mas eu ainda nao vendo isso."
    nodeType: 0
    choices:
    - choiceText: "E as restricoes de estacao?"
      nextNodeId: tip_season
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Obrigado pela dica!"
      nextNodeId: ""
      requirements: []
      effects:
      - effectType: 1
        effectKey: maren
        effectValue: ""
        numericValue: 1
        description: "+1 por agradecer"
      isExitChoice: 1
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []

  - nodeId: tip_season
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "Cada planta tem sua estacao preferida. Cenoura e repolho na Primavera,
      tomate no Verao, abobora no Outono, rabanete na Primavera ou Outono. Tente
      plantar fora de hora e a terra vai recusar."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []

  # ---- TOPIC: segredo (rel >= 40) ----
  - nodeId: topic_secret
    speakerName: Maren
    speakerEmotion: 7
    speakerPosition: 0
    dialogueText: "Voce perguntou... entao vou contar. Tenho uma semente no bolso
      que nunca plantei. Era do meu pai. Nao sei que planta e — e nao tenho
      coragem de descobrir, porque se morrer, perderei a ultima coisa que me resta dele."
    nodeType: 0
    choices:
    - choiceText: "Voce deveria plantar. E o que ele teria querido."
      nextNodeId: secret_plant
      requirements: []
      effects:
      - effectType: 1
        effectKey: maren
        effectValue: ""
        numericValue: 5
        description: "+5 por encorajamento sincero"
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Guarde como lembranca. E dela tambem."
      nextNodeId: secret_keep
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []

  - nodeId: secret_plant
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Talvez voce tenha razao. Quando eu tiver coragem, voce vai saber
      primeiro. Prometo. Obrigada... de verdade."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects:
    - effectType: 0
      effectKey: maren_encouraged_seed
      effectValue: "true"
      numericValue: 0
      description: "Flag: encorajou Maren"

  - nodeId: secret_keep
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "E... voce tem razao tambem. Algumas coisas ficam melhores guardadas.
      Mas e bom poder falar sobre isso com alguem que entende."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []

  tags:
  - default
  - everyday
  priority: 0
