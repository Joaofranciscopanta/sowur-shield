  m_Script: {fileID: 11500000, guid: b9b5041c652cccf43bbd575d56fe419f, type: 3}
  m_Name: Maren_Default
  m_EditorClassIdentifier: SowurShield.Dialogue.DialogueTree
  conversationId: maren_default
  conversationDescription: "Maren's everyday greeting with topic choices that unlock more lore as relationship grows."
  startNodeId: start
  isRepeatable: 1
  saveProgressOnExit: 1
  nodes:
  - nodeId: start
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Good morning! The garden beds are calling. What can I do for you?"
    nodeType: 0
    choices:
    - choiceText: "Tell me about yourself."
      nextNodeId: topic_about
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "What do you think of this valley?"
      nextNodeId: topic_valley
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Give me a planting tip."
      nextNodeId: topic_tip
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "What are you keeping so close to your heart?"
      nextNodeId: topic_secret
      requirements:
      - conditionType: 2
        conditionKey: maren
        conditionOperator: 2
        conditionValue: "40"
        invertCondition: 0
        description: "Available only with rel >= 40"
      effects: []
      isExitChoice: 0
      choiceColor: {r: 0.9, g: 0.85, b: 0.5, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: topic_about
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "I'm a farmer's daughter from the eastern valley. I learned to plant before I learned to write. But the drought spares no one — I ended up here after losing everything."
    nodeType: 0
    choices:
    - choiceText: "That must have been hard to start over."
      nextNodeId: about_restart
      requirements: []
      effects:
      - effectType: 1
        effectKey: maren
        effectValue: ""
        numericValue: 2
        description: "+2 for empathy"
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "You've adapted well."
      nextNodeId: about_adapted
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: about_restart
    speakerName: Maren
    speakerEmotion: 2
    speakerPosition: 0
    dialogueText: "It was. But the soil here has something special about it. It welcomed me in a way the eastern valley never did. Maybe this is what I call home now."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: about_adapted
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "It took a while. Every soil is different — it has its own ways. But I learned to listen to what the land asks of me."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: topic_valley
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "This valley has history. People come, plant, harvest and leave. Few stay. Something here keeps you — the land, the rhythm of the seasons, I don't know."
    nodeType: 0
    choices:
    - choiceText: "Is there something mystical about this land?"
      nextNodeId: valley_mystic
      requirements:
      - conditionType: 2
        conditionKey: maren
        conditionOperator: 2
        conditionValue: "10"
        invertCondition: 0
        description: "Appears only with rel >= 10 (Friend+)"
      effects: []
      isExitChoice: 0
      choiceColor: {r: 0.85, g: 0.95, b: 1, a: 1}
    - choiceText: "I understand that feeling."
      nextNodeId: valley_feel
      requirements: []
      effects:
      - effectType: 1
        effectKey: maren
        effectValue: ""
        numericValue: 1
        description: "+1 for agreeing"
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: valley_mystic
    speakerName: Maren
    speakerEmotion: 5
    speakerPosition: 0
    dialogueText: "They say a druid blessed the deepest layers of soil here. I don't know if I believe it, but the plants grow too fast to just be the climate. Take good care of your beds' fertility — it's more valuable than it looks."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects:
    - effectType: 0
      effectKey: maren_told_valley_lore
      effectValue: "true"
      numericValue: 0
      description: "Flag: player learned the druid lore"
  - nodeId: valley_feel
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Good. That means you came to stay. The best harvests come from those who plant with intention."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: topic_tip
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Tip of the day: soil gets tired. Every harvest takes a little fertility away. The less fertile it is, the less you yield. Let the soil rest or use fertilizer — though I don't sell that yet."
    nodeType: 0
    choices:
    - choiceText: "What about seasonal restrictions?"
      nextNodeId: tip_season
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Thanks for the tip!"
      nextNodeId: ""
      requirements: []
      effects:
      - effectType: 1
        effectKey: maren
        effectValue: ""
        numericValue: 1
        description: "+1 for thanking"
      isExitChoice: 1
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: tip_season
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "Every plant has its preferred season. Carrot and cabbage in Spring, tomato in Summer, pumpkin in Fall, radish in Spring or Fall. Try planting out of season and the land will refuse."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: topic_secret
    speakerName: Maren
    speakerEmotion: 7
    speakerPosition: 0
    dialogueText: "You asked... so I'll tell you. I have a seed in my pocket I've never planted. It was my father's. I don't know what plant it is — and I don't have the courage to find out, because if it dies, I'll lose the last thing I have left of him."
    nodeType: 0
    choices:
    - choiceText: "You should plant it. It's what he would have wanted."
      nextNodeId: secret_plant
      requirements: []
      effects:
      - effectType: 1
        effectKey: maren
        effectValue: ""
        numericValue: 5
        description: "+5 for sincere encouragement"
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Keep it as a memory. It belongs to her too."
      nextNodeId: secret_keep
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  - nodeId: secret_plant
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Maybe you're right. When I have the courage, you'll be the first to know. I promise. Thank you... truly."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects:
    - effectType: 0
      effectKey: maren_encouraged_seed
      effectValue: "true"
      numericValue: 0
      description: "Flag: encouraged Maren"
  - nodeId: secret_keep
    speakerName: Maren
    speakerEmotion: 0
    speakerPosition: 0
    dialogueText: "You're... right too. Some things are better kept. But it's good to be able to talk about it with someone who understands."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  tags:
  - default
  - everyday
  priority: 0
