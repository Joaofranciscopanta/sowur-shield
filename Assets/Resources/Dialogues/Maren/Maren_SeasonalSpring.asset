  m_Name: Maren_SeasonalSpring
  m_EditorClassIdentifier: SowurShield.Dialogue.DialogueTree
  conversationId: maren_seasonal_spring
  conversationDescription: "Spring greeting. Triggered when worldString 'season' == 'Spring' and relationship < 40. Low-priority seasonal flavour."
  startNodeId: start
  isRepeatable: 1
  saveProgressOnExit: 0
  nodes:
  - nodeId: start
    speakerName: Maren
    speakerEmotion: 6
    speakerPosition: 0
    dialogueText: "Spring! This is the best time to start. Carrots and radishes come up quickly — if you haven't planted yet, hurry before the soil cools down again."
    nodeType: 0
    choices:
    - choiceText: "Which seeds do you recommend right now?"
      nextNodeId: spring_tip
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Thanks for the tip."
      nextNodeId: ""
      requirements: []
      effects: []
      isExitChoice: 1
      choiceColor: {r: 0.8, g: 0.8, b: 0.8, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions:
    - conditionType: 5
      conditionKey: season
      conditionOperator: 0
      conditionValue: Spring
      invertCondition: 0
      description: "Only in Spring"
    nodeEffects: []
  - nodeId: spring_tip
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Carrot and cabbage are my bet. They grow fast, sell well, and refresh the soil for summer. Avoid pumpkin for now — it's finicky and only blooms in fall."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  tags:
  - seasonal
  - spring
  priority: 5
