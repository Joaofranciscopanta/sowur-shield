  m_Script: {fileID: 11500000, guid: b9b5041c652cccf43bbd575d56fe419f, type: 3}
  m_Name: Maren_SeasonalSpring
  m_EditorClassIdentifier: SowurShield.Dialogue.DialogueTree
  conversationId: maren_seasonal_spring
  conversationDescription: "Spring greeting. Triggered when worldString 'season' ==
    'Spring' and relationship < 40. Low-priority seasonal flavour."
  startNodeId: start
  isRepeatable: 1
  saveProgressOnExit: 0
  nodes:
  - nodeId: start
    speakerName: Maren
    speakerEmotion: 6
    speakerPosition: 0
    dialogueText: "Primavera! Essa e a melhor epoca para comecar. Cenouras e
      rabanetes saem rapido — se voce ainda nao plantou, corra antes que o
      solo esfrie de novo."
    nodeType: 0
    choices:
    - choiceText: "Quais sementes voce recomenda agora?"
      nextNodeId: spring_tip
      requirements: []
      effects: []
      isExitChoice: 0
      choiceColor: {r: 1, g: 1, b: 1, a: 1}
    - choiceText: "Obrigado pela dica."
      nextNodeId: ""
      requirements: []
      effects: []
      isExitChoice: 1
      choiceColor: {r: 0.8, g: 0.8, b: 0.8, a: 1}
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions:
    - conditionType: 5
      conditionKey: season
      conditionOperator: 0
      conditionValue: Spring
      invertCondition: 0
      description: "So na Primavera"
    nodeEffects: []
  - nodeId: spring_tip
    speakerName: Maren
    speakerEmotion: 1
    speakerPosition: 0
    dialogueText: "Cenoura e repolho sao minha aposta. Crescem rapido, vendem bem
      e refrescam o solo para o verao. Evite abobora agora — ela e caprichosa
      e so floresce no outono."
    nodeType: 0
    choices: []
    nextNodeId: ""
    autoAdvanceDelay: 0
    displayConditions: []
    nodeEffects: []
  tags:
  - seasonal
  - spring
  priority: 5
