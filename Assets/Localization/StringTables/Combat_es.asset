  m_TableData:
  - m_Id: 300670976
    m_Localized: 'Felicidad: {0:F0}%'
    m_Metadata:
      m_Items: []
  - m_Id: 317448192
    m_Localized: Alimentado
    m_Metadata:
      m_Items: []
  - m_Id: 317448193
    m_Localized: No necesita alimento
    m_Metadata:
      m_Items: []
  - m_Id: 317448194
    m_Localized: 'Necesita:'
    m_Metadata:
      m_Items: []
  - m_Id: 317448195
    m_Localized: '{0}x {1} '
    m_Metadata:
      m_Items: []
  - m_Id: 317448196
    m_Localized: "\xA1Combo x{0}!"
    m_Metadata:
      m_Items: []
  - m_Id: 317448197
    m_Localized: "*** \xA1VICTORIA! ***"
    m_Metadata:
      m_Items: []
  - m_Id: 317448198
    m_Localized: -- DERROTA --
    m_Metadata:
      m_Items: []
  - m_Id: 317448199
    m_Localized: "\u23F1\uFE0F EMPATE \u23F1\uFE0F"
    m_Metadata:
      m_Items: []
  - m_Id: 317448200
    m_Localized: "\\n\\n\xA1L\xEDmite de turnos alcanzado!"
    m_Metadata:
      m_Items: []
  - m_Id: 317448201
    m_Localized: 'Recompensas Parciales:\nOro: 50\nXP: 25 (todas las unidades)'
    m_Metadata:
      m_Items: []
  - m_Id: 317448202
    m_Localized: "<b>Estad\xEDsticas de la Batalla</b>\\n\\nTurnos: {0}\\nTus Sobrevivientes:
      {1}\\nSobrevivientes Enemigos: {2}\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 317448203
    m_Localized: Sin recompensas.
    m_Metadata:
      m_Items: []
  - m_Id: 317448204
    m_Localized: <b>Recompensas</b>\n\n
    m_Metadata:
      m_Items: []
  - m_Id: 317448205
    m_Localized: 'Oro: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448206
    m_Localized: 'XP: +{0} (unidades sobrevivientes)'
    m_Metadata:
      m_Items: []
  - m_Id: 317448207
    m_Localized: '{0} x{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448208
    m_Localized: 'Felicidad Animal: +{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448209
    m_Localized: 'Turno: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448210
    m_Localized: 'Tu Equipo: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448211
    m_Localized: 'Enemigos: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448212
    m_Localized: Objetos
    m_Metadata:
      m_Items: []
  - m_Id: 317448213
    m_Localized: Inventario no encontrado
    m_Metadata:
      m_Items: []
  - m_Id: 317448214
    m_Localized: Sin consumibles
    m_Metadata:
      m_Items: []
  - m_Id: 317448215
    m_Localized: '{0} x{1} (+{2} PV)'
    m_Metadata:
      m_Items: []
  - m_Id: 317448216
    m_Localized: ({0},{1})
    m_Metadata:
      m_Items: []
  - m_Id: 317448217
    m_Localized: 'Zona: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448218
    m_Localized: 'Equipo: {0}/15'
    m_Metadata:
      m_Items: []
  - m_Id: 317448219
    m_Localized: "\xA1Todos los animales alimentados!"
    m_Metadata:
      m_Items: []
  - m_Id: 317448220
    m_Localized: Comida Necesaria:\n
    m_Metadata:
      m_Items: []
  - m_Id: 317448221
    m_Localized: "\u2022 {0}x {1}\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 317448222
    m_Localized: Sinergias:\n
    m_Metadata:
      m_Items: []
  - m_Id: 317448223
    m_Localized: "\u2022 {0}x {1} (Bono de Pila)\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 317448224
    m_Localized: Sin sinergias activas
    m_Metadata:
      m_Items: []
  - m_Id: 317448225
    m_Localized: Animales Disponibles
    m_Metadata:
      m_Items: []
  - m_Id: 317448226
    m_Localized: '{0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2630370326208512
    m_Localized: "Murci\xE9lago de Cueva"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180032
    m_Localized: Trol de Cueva
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180033
    m_Localized: Escarabajo de Cristal
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180034
    m_Localized: "Ara\xF1a Oscura"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180035
    m_Localized: Espora de Hongo
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180036
    m_Localized: Acechador de las Sombras
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180037
    m_Localized: "G\xF3lem de Piedra"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180038
    m_Localized: Lobo Ancestral
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180039
    m_Localized: "Jabal\xED del Bosque"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180040
    m_Localized: "Gran B\xFAho"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180041
    m_Localized: Lobo Aullador
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180042
    m_Localized: Rana Venenosa
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180043
    m_Localized: Treant
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180044
    m_Localized: "Esp\xEDritu de Enredadera"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180045
    m_Localized: Cuervo
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180046
    m_Localized: Rata de Campo
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180047
    m_Localized: Limo Gigante
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180048
    m_Localized: Abeja
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180049
    m_Localized: Lobo de la Pradera
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180050
    m_Localized: Limo
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180051
    m_Localized: Oso Acorazado
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180052
    m_Localized: "Drag\xF3n de Escarcha"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180053
    m_Localized: "Arp\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180054
    m_Localized: "G\xF3lem de Hierro"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180055
    m_Localized: "Rey de la Monta\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180056
    m_Localized: Sabueso de Roca
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180057
    m_Localized: "\xC1guila del Trueno"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180058
    m_Localized: Diablillo de Fuego
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180059
    m_Localized: Sabueso Infernal
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180060
    m_Localized: "Drag\xF3n del Infierno"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180061
    m_Localized: Salamandra de Lava
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180062
    m_Localized: Limo de Magma
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180063
    m_Localized: "G\xF3lem de Obsidiana"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180064
    m_Localized: "Drag\xF3n Volc\xE1nico"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180065
    m_Localized: Una batalla normal.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180066
    m_Localized: "\xA1Los medidores de turno se llenan el doble de r\xE1pido!"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180067
    m_Localized: "Precisi\xF3n reducida para todos los combatientes."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180068
    m_Localized: Todas las unidades se curan un poco cada ronda.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180069
    m_Localized: "\xA1El da\xF1o causado y recibido se duplica!"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180070
    m_Localized: Campos Soleados
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180071
    m_Localized: Una suave brisa recorre la hierba dorada. Un lugar perfecto para
      comenzar tu viaje.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180072
    m_Localized: "Jard\xEDn de Flores"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180073
    m_Localized: "Las flores coloridas esconden plagas peque\xF1as pero persistentes."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180074
    m_Localized: Colinas Onduladas
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180075
    m_Localized: La velocidad lo es todo en terreno abierto.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180076
    m_Localized: Pradera del Viento
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180077
    m_Localized: "El Limo Gigante patrulla estas llanuras. Golpea m\xE1s fuerte de
      lo que parece."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180078
    m_Localized: "Pastizal Tranquilo \u2014 Jefe"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180079
    m_Localized: "[JEFE] El Lobo de la Pradera guarda el camino al bosque. Derr\xF3talo
      para avanzar."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180080
    m_Localized: Bosque Susurrante
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180081
    m_Localized: "Los \xE1rboles se cierran alrededor. Sonidos extra\xF1os resuenan
      desde el follaje."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180082
    m_Localized: Arboleda Oscura
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180083
    m_Localized: Ranas Venenosas se esconden bajo la maleza.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180084
    m_Localized: Bosque Ancestral
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180085
    m_Localized: "El aullido se intensifica. Los lobos cazan en manadas aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180086
    m_Localized: "Claro del Crep\xFAsculo"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180087
    m_Localized: "Un Gran B\xFAho observa desde arriba. El Treant se agita."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180088
    m_Localized: "Hueco Musgoso \u2014 Jefe"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180089
    m_Localized: '[JEFE] El Lobo Ancestral domina este bosque. Su manada lo defiende
      ferozmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180090
    m_Localized: Caverna de Cristal
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180091
    m_Localized: "Los cristales brillan tenuemente. Los murci\xE9lagos se lanzan
      desde el techo."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180092
    m_Localized: "Profundidades Sombr\xEDas"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180093
    m_Localized: "Las Ara\xF1as Oscuras tejen telara\xF1as en cada pasaje."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180094
    m_Localized: "C\xE1mara del Eco"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180095
    m_Localized: "O Golem de Pedra quase n\xE3o se move"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180096
    m_Localized: "Lago Subterr\xE1neo"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180097
    m_Localized: "Algo r\xE1pido se mueve en las sombras. No dejes que llegue a tu
      l\xEDnea trasera."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180098
    m_Localized: "Sal\xF3n de Estalactitas \u2014 Jefe"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180099
    m_Localized: "[JEFE] El Trol de Cueva llena toda la c\xE1mara. Resistente Y agresivo."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180100
    m_Localized: Pico Rocoso
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180101
    m_Localized: "Los Sabuesos de Roca patrullan los senderos bajos. M\xE1s fuertes
      que los lobos del bosque."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180102
    m_Localized: "Nido del \xC1guila"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180103
    m_Localized: "Las Arp\xEDas y \xC1guilas del Trueno se lanzan desde los picos."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180104
    m_Localized: Paso del Gigante de Piedra
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180105
    m_Localized: "Osos Acorazados y G\xF3lems de Hierro bloquean el paso de la monta\xF1a."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180106
    m_Localized: Cresta de las Nubes
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180107
    m_Localized: "Un Drag\xF3n de Escarcha sobrevuela en c\xEDrculos. Las \xC1guilas
      del Trueno de \xE9lite lo escoltan."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180108
    m_Localized: "Cumbre Helada \u2014 Jefe"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180109
    m_Localized: "[JEFE] El Rey de la Monta\xF1a comanda tanto la cumbre como la
      tormenta. Nada sobrevive aqu\xED."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180110
    m_Localized: Campos de Lava
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180111
    m_Localized: El suelo arde. Las Salamandras de Lava son la menor de tus preocupaciones.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180112
    m_Localized: Caldera de Cenizas
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180113
    m_Localized: "Los Diablillos de Fuego se mueven m\xE1s r\xE1pido que nada que
      hayas enfrentado. Golpean dos veces antes de que parpadees."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180114
    m_Localized: Pico de Obsidiana
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180115
    m_Localized: "G\xF3lems de Obsidiana y Sabuesos Infernales. Uno no muere; el
      otro te mata primero."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180116
    m_Localized: Cuenca de Fuego
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180117
    m_Localized: "El Drag\xF3n Volc\xE1nico y su guardia de \xE9lite. La \xFAltima
      prueba antes del Drag\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180118
    m_Localized: "N\xFAcleo de Magma \u2014 Jefe Final"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180119
    m_Localized: "[JEFE FINAL] El Drag\xF3n del Infierno. Amenaza m\xE1xima absoluta.
      Trae tus mejores animales \u2014 bien alimentados y acariciados."
    m_Metadata:
      m_Items: []
  - m_Id: 14964601198993408
    m_Localized: Lobo de Nieve
    m_Metadata:
      m_Items: []
  - m_Id: 14964601421291520
    m_Localized: Elemental de Hielo
    m_Metadata:
      m_Items: []
  - m_Id: 14964601454845952
    m_Localized: "Bandido de la Monta\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 14964601488400384
    m_Localized: Yeti de Piedra
    m_Metadata:
      m_Items: []
  - m_Id: 14964601521954816
    m_Localized: "G\xF3lem de Escarcha"
    m_Metadata:
      m_Items: []
  - m_Id: 14964601555509248
    m_Localized: "Tit\xE1n de la Monta\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 14964601593257984
    m_Localized: Limo de Fuego
    m_Metadata:
      m_Items: []
  - m_Id: 14964601626812416
    m_Localized: Lagarto de Magma
    m_Metadata:
      m_Items: []
  - m_Id: 14964601664561152
    m_Localized: Caballero de Lava
    m_Metadata:
      m_Items: []
  - m_Id: 14964601698115584
    m_Localized: Demonio Infernal
    m_Metadata:
      m_Items: []
  - m_Id: 14964601731670016
    m_Localized: Coloso de Llamas
    m_Metadata:
      m_Items: []
  - m_Id: 14964601765224448
    m_Localized: "Se\xF1or de las Cenizas"
    m_Metadata:
      m_Items: []
  - m_Id: 15112532682072064
    m_Localized: 'Modo: Pausa Activa'
    m_Metadata:
      m_Items: []
  - m_Id: 15112532724015104
    m_Localized: "Modo: Autom\xE1tico"
    m_Metadata:
      m_Items: []
  references:
