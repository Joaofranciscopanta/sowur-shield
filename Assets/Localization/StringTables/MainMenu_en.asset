  - m_Id: 296476684
    m_Localized: 'Save File Information\n\nFile: {0}\nCreated: {1}\nLast Saved: {2}\nSize:
      {3}\n\n Game saves automatically when you sleep in bed'
    m_Metadata:
      m_Items: []
  - m_Id: 296476685
    m_Localized: No save file found\n\nSleep in a bed to save your progress automatically.\n\nThe
      game will create a save file when you go to sleep for the first time.
    m_Metadata:
      m_Items: []
