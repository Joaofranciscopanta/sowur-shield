  - m_Id: 317448192
    m_Localized: Alimentado
    m_Metadata:
      m_Items: []
  - m_Id: 317448193
    m_Localized: "Nenhum alimento necess\xE1rio"
    m_Metadata:
      m_Items: []
  - m_Id: 317448194
    m_Localized: 'Precisa: '
    m_Metadata:
      m_Items: []
  - m_Id: 317448195
    m_Localized: '{0}x {1} '
    m_Metadata:
      m_Items: []
  - m_Id: 317448196
    m_Localized: Combo x{0}!
    m_Metadata:
      m_Items: []
  - m_Id: 317448197
    m_Localized: "*** VIT\xD3RIA! ***"
    m_Metadata:
      m_Items: []
  - m_Id: 317448198
    m_Localized: -- DERROTA --
    m_Metadata:
      m_Items: []
  - m_Id: 317448199
    m_Localized: "\u23F1\uFE0F EMPATE \u23F1\uFE0F"
    m_Metadata:
      m_Items: []
  - m_Id: 317448200
    m_Localized: \n\nLimite de turnos atingido!
    m_Metadata:
      m_Items: []
  - m_Id: 317448201
    m_Localized: 'Recompensas Parciais:\nOuro: 50\nXP: 25 (todas as unidades)'
    m_Metadata:
      m_Items: []
  - m_Id: 317448202
    m_Localized: "<b>Estat\xEDsticas da Batalha</b>\\n\\nTurnos: {0}\\nSeus Sobreviventes:
      {1}\\nSobreviventes Inimigos: {2}\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 317448203
    m_Localized: Sem recompensas.
    m_Metadata:
      m_Items: []
  - m_Id: 317448204
    m_Localized: <b>Recompensas</b>\n\n
    m_Metadata:
      m_Items: []
  - m_Id: 317448205
    m_Localized: 'Ouro: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448206
    m_Localized: 'XP: +{0} (unidades sobreviventes)'
    m_Metadata:
      m_Items: []
  - m_Id: 317448207
    m_Localized: '{0} x{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448208
    m_Localized: 'Felicidade Animal: +{0}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448209
    m_Localized: 'Turno: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448210
    m_Localized: 'Seu Time: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448211
    m_Localized: 'Inimigos: {0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448212
    m_Localized: Itens
    m_Metadata:
      m_Items: []
  - m_Id: 317448213
    m_Localized: "Invent\xE1rio n\xE3o encontrado"
    m_Metadata:
      m_Items: []
  - m_Id: 317448214
    m_Localized: "Nenhum consum\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 317448215
    m_Localized: '{0} x{1} (+{2} PV)'
    m_Metadata:
      m_Items: []
  - m_Id: 317448216
    m_Localized: ({0},{1})
    m_Metadata:
      m_Items: []
  - m_Id: 317448217
    m_Localized: 'Zona: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 317448218
    m_Localized: 'Time: {0}/15'
    m_Metadata:
      m_Items: []
  - m_Id: 317448219
    m_Localized: Todos os animais alimentados!
    m_Metadata:
      m_Items: []
  - m_Id: 317448220
    m_Localized: "Comida Necess\xE1ria:\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 317448221
    m_Localized: "\u2022 {0}x {1}\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 317448222
    m_Localized: Sinergias:\n
    m_Metadata:
      m_Items: []
  - m_Id: 317448223
    m_Localized: "\u2022 {0}x {1} (B\xF4nus de Pilha)\\n"
    m_Metadata:
      m_Items: []
  - m_Id: 317448224
    m_Localized: Nenhuma sinergia ativa
    m_Metadata:
      m_Items: []
  - m_Id: 317448225
    m_Localized: "Animais Dispon\xEDveis"
    m_Metadata:
      m_Items: []
  - m_Id: 317448226
    m_Localized: '{0}/{1}'
    m_Metadata:
      m_Items: []
  - m_Id: 2630370326208512
    m_Localized: Morcego da Caverna
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180032
    m_Localized: Troll da Caverna
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180033
    m_Localized: Besouro de Cristal
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180034
    m_Localized: Aranha Sombria
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180035
    m_Localized: Esporo de Cogumelo
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180036
    m_Localized: Perseguidor das Sombras
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180037
    m_Localized: Golem de Pedra
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180038
    m_Localized: Lobo Ancestral
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180039
    m_Localized: Javali da Floresta
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180040
    m_Localized: Grande Coruja
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180041
    m_Localized: Lobo Uivante
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180042
    m_Localized: Sapo Venenoso
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180043
    m_Localized: Treant
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180044
    m_Localized: "Esp\xEDrito de Trepadeira"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180045
    m_Localized: Corvo
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180046
    m_Localized: Rato do Campo
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180047
    m_Localized: Gosma Gigante
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180048
    m_Localized: Abelha
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180049
    m_Localized: Lobo da Pradaria
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180050
    m_Localized: Gosma
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180054
    m_Localized: Golem de Ferro
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180063
    m_Localized: Golem de Obsidiana
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180065
    m_Localized: Uma batalha normal.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180066
    m_Localized: "Os medidores de turno enchem duas vezes mais r\xE1pido!"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180067
    m_Localized: "Precis\xE3o reduzida para todos os combatentes."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180068
    m_Localized: Todas as unidades curam um pouco a cada rodada.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180069
    m_Localized: "O dano causado e recebido \xE9 dobrado!"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180070
    m_Localized: Campos Ensolarados
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180071
    m_Localized: "Uma brisa suave passa pela grama dourada. Um lugar perfeito para
      come\xE7ar sua jornada."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180072
    m_Localized: Jardim de Flores
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180073
    m_Localized: Flores coloridas escondem pragas pequenas mas persistentes.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180074
    m_Localized: Colinas Ondulantes
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180075
    m_Localized: "Velocidade \xE9 tudo em terreno aberto."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180076
    m_Localized: Pradaria dos Ventos
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180077
    m_Localized: "A Gosma Gigante patrulha estas plan\xEDcies. Ela bate mais forte
      do que parece."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180078
    m_Localized: "Pasto Tranquilo \u2014 Chefe"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180079
    m_Localized: "[CHEFE] O Lobo da Pradaria guarda o caminho para a floresta. Derrote-o
      para avan\xE7ar."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180080
    m_Localized: Bosque Sussurrante
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180081
    m_Localized: "As \xE1rvores se fecham ao redor. Sons estranhos ecoam da copa."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180082
    m_Localized: Bosque Sombrio
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180083
    m_Localized: "Sapos Venenosos se escondem sob a vegeta\xE7\xE3o rasteira."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180084
    m_Localized: Floresta Ancestral
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180085
    m_Localized: "O uivo se intensifica. Lobos ca\xE7am em bandos aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180086
    m_Localized: "Clareira do Crep\xFAsculo"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180087
    m_Localized: Uma Grande Coruja observa do alto. O Treant se agita.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180088
    m_Localized: "Vale Musgoso \u2014 Chefe"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180089
    m_Localized: '[CHEFE] O Lobo Ancestral domina esta floresta. Sua matilha o defende
      ferozmente.'
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180090
    m_Localized: Caverna de Cristal
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180091
    m_Localized: Os cristais brilham fracamente. Morcegos mergulham do teto.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180092
    m_Localized: Profundezas Sombrias
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180093
    m_Localized: Aranhas Sombrias tecem teias em todas as passagens.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180094
    m_Localized: "C\xE2mara do Eco"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180095
    m_Localized: ' but it barely flinches either.'
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180096
    m_Localized: "Lago Subterr\xE2neo"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180097
    m_Localized: "Algo r\xE1pido se move nas sombras. N\xE3o deixe que alcance sua
      linha de tr\xE1s."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180098
    m_Localized: "Sal\xE3o das Estalactites \u2014 Chefe"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180099
    m_Localized: "[CHEFE] O Troll da Caverna enche toda a c\xE2mara. Resistente E
      agressivo."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180100
    m_Localized: Pico Rochoso
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180101
    m_Localized: "C\xE3es de Pedra patrulham os caminhos inferiores. Mais fortes
      que os lobos da floresta."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180102
    m_Localized: "Ninho da \xC1guia"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180103
    m_Localized: "Harpias e \xC1guias do Trov\xE3o mergulham dos picos."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180104
    m_Localized: Passagem do Gigante de Pedra
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180105
    m_Localized: Ursos Blindados e Golens de Ferro bloqueiam a passagem da montanha.
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180106
    m_Localized: Crista das Nuvens
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180107
    m_Localized: "Um Drag\xE3o de Gelo circula no alto. As \xC1guias do Trov\xE3o
      de elite o escoltam."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180108
    m_Localized: "Cume Congelado \u2014 Chefe"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180109
    m_Localized: '[CHEFE] O Rei da Montanha comanda tanto o pico quanto a tempestade.
      Nada sobrevive aqui.'
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180110
    m_Localized: Campos de Lava
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180111
    m_Localized: "O solo queima. As Salamandras de Lava s\xE3o a menor das suas preocupa\xE7\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180112
    m_Localized: Caldeira Cinzenta
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180113
    m_Localized: "Diabretes de Fogo se movem mais r\xE1pido do que tudo que voc\xEA
      j\xE1 enfrentou. Eles atacam duas vezes antes que voc\xEA pisque."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180114
    m_Localized: Pico de Obsidiana
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180115
    m_Localized: "Golens de Obsidiana e C\xE3es do Inferno. Um n\xE3o morre; o outro
      te mata primeiro."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180116
    m_Localized: Bacia de Fogo
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180117
    m_Localized: "O Drag\xE3o Vulc\xE2nico e sua guarda de elite. O \xFAltimo teste
      antes do Drag\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180118
    m_Localized: "N\xFAcleo de Magma \u2014 Chefe Final"
    m_Metadata:
      m_Items: []
  - m_Id: 2630370347180119
    m_Localized: "[CHEFE FINAL] O Drag\xE3o do Inferno. Amea\xE7a m\xE1xima absoluta.
      Traga seus melhores animais \u2014 bem alimentados e acariciados."
    m_Metadata:
      m_Items: []
  - m_Id: 14964601198993408
    m_Localized: Lobo da Neve
    m_Metadata:
      m_Items: []
  - m_Id: 14964601421291520
    m_Localized: Elemental de Gelo
    m_Metadata:
      m_Items: []
  - m_Id: 14964601454845952
    m_Localized: Bandido da Montanha
    m_Metadata:
      m_Items: []
  - m_Id: 14964601488400384
    m_Localized: Yeti de Pedra
    m_Metadata:
      m_Items: []
  - m_Id: 14964601521954816
    m_Localized: Golem de Gelo
    m_Metadata:
      m_Items: []
  - m_Id: 14964601555509248
    m_Localized: "Tit\xE3 da Montanha"
    m_Metadata:
      m_Items: []
  - m_Id: 14964601593257984
    m_Localized: Gosma de Fogo
    m_Metadata:
      m_Items: []
  - m_Id: 14964601626812416
    m_Localized: Lagarto de Magma
    m_Metadata:
      m_Items: []
  - m_Id: 14964601664561152
    m_Localized: Cavaleiro de Lava
    m_Metadata:
      m_Items: []
  - m_Id: 14964601698115584
    m_Localized: "Dem\xF4nio Infernal"
    m_Metadata:
      m_Items: []
  - m_Id: 14964601731670016
    m_Localized: Colosso de Chamas
    m_Metadata:
      m_Items: []
  - m_Id: 14964601765224448
    m_Localized: Senhor das Cinzas
    m_Metadata:
      m_Items: []
  - m_Id: 15112532682072064
    m_Localized: 'Modo: Pausa Ativa'
    m_Metadata:
      m_Items: []
  - m_Id: 15112532724015104
    m_Localized: "Modo: Autom\xE1tico"
    m_Metadata:
      m_Items: []
  - m_Id: 15114063577866240
    m_Localized: Atacar
    m_Metadata:
      m_Items: []
  - m_Id: 15114063624003584
    m_Localized: Defender
    m_Metadata:
      m_Items: []
  - m_Id: 15114063624003585
    m_Localized: Voltar
    m_Metadata:
      m_Items: []
  - m_Id: 15114063624003586
    m_Localized: "Escolha uma a\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 15114063624003587
    m_Localized: Clique num inimigo para mirar
    m_Metadata:
      m_Items: []
  - m_Id: 15114063624003588
    m_Localized: '{0} [{1}]'
    m_Metadata:
      m_Items: []
  - m_Id: 15133377987076096
    m_Localized: "Vit\xF3ria!"
    m_Metadata:
      m_Items: []
  - m_Id: 15133378003853312
    m_Localized: Derrota...
    m_Metadata:
      m_Items: []
  - m_Id: 15133378003853313
    m_Localized: Para a Fazenda
    m_Metadata:
      m_Items: []
  - m_Id: 15133378003853314
    m_Localized: Tentar de Novo
    m_Metadata:
      m_Items: []
  - m_Id: 15133378003853315
    m_Localized: Alimentar Todos
    m_Metadata:
