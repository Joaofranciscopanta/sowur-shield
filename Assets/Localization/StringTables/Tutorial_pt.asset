  m_TableData:
  - m_Id: 300670976
    m_Localized: Are o solo
    m_Metadata:
      m_Items: []
  - m_Id: 313253888
    m_Localized: "Bem-vindo \xE0 sua fazenda!\\n\\nEquipe a <b>Enxada</b> da sua
      barra de itens e, em seguida, <b>clique com o bot\xE3o esquerdo</b> em um bloco
      de terra para arar."
    m_Metadata:
      m_Items: []
  - m_Id: 313253889
    m_Localized: Plante uma semente
    m_Metadata:
      m_Items: []
  - m_Id: 313253890
    m_Localized: "\xD3timo! Agora equipe uma <b>Semente</b> e <b>clique com o bot\xE3o
      esquerdo</b> no solo arado para plant\xE1-la."
    m_Metadata:
      m_Items: []
  - m_Id: 313253891
    m_Localized: "Regue a planta\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 313253892
    m_Localized: "As planta\xE7\xF5es precisam de \xE1gua para crescer. Equipe o
      <b>Regador</b> e <b>clique com o bot\xE3o esquerdo</b> no solo plantado."
    m_Metadata:
      m_Items: []
  - m_Id: 313253893
    m_Localized: Acaricie um animal
    m_Metadata:
      m_Items: []
  - m_Id: 313253894
    m_Localized: "Visite um animal e pressione <b>E</b> para acarici\xE1-lo. Animais
      felizes produzem mais!"
    m_Metadata:
      m_Items: []
  - m_Id: 313253895
    m_Localized: "Durma para avan\xE7ar o dia"
    m_Metadata:
      m_Items: []
  - m_Id: 313253896
    m_Localized: "O tempo passa quando voc\xEA dorme. Caminhe at\xE9 a <b>cama</b>
      e pressione <b>E</b> para dormir."
    m_Metadata:
      m_Items: []
  - m_Id: 313253897
    m_Localized: "Colha uma planta\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 313253898
    m_Localized: "Suas planta\xE7\xF5es cresceram! Caminhe at\xE9 uma <b>planta\xE7\xE3o
      pronta</b> e pressione <b>E</b> ou clique com o bot\xE3o esquerdo para colher."
    m_Metadata:
      m_Items: []
  - m_Id: 313253899
    m_Localized: 'Passo {0}/{1}: {2}'
    m_Metadata:
      m_Items: []
  references:
    version: 2
