  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Tutorial_es
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es
  m_SharedData: {fileID: 11400000, guid: 2e6f08e87d0a6aa4eae442eaa8562d86, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 300670976
    m_Localized: Ara la tierra
    m_Metadata:
      m_Items: []
  - m_Id: 313253888
    m_Localized: "\xA1Bienvenido a tu granja! Equipa la <b>Azada</b> desde tu barra
      de acceso r\xE1pido, luego haz <b>clic izquierdo</b> en una parcela de tierra
      para ararla."
    m_Metadata:
      m_Items: []
  - m_Id: 313253889
    m_Localized: Planta una semilla
    m_Metadata:
      m_Items: []
  - m_Id: 313253890
    m_Localized: "\xA1Genial! Ahora equipa una <b>Semilla</b> y haz <b>clic izquierdo</b>
      en la tierra arada para plantarla."
    m_Metadata:
      m_Items: []
  - m_Id: 313253891
    m_Localized: Riega el cultivo
    m_Metadata:
      m_Items: []
  - m_Id: 313253892
    m_Localized: Los cultivos necesitan agua para crecer. Equipa la <b>Regadera</b>
      y haz <b>clic izquierdo</b> en la tierra plantada.
    m_Metadata:
      m_Items: []
  - m_Id: 313253893
    m_Localized: Acaricia a un animal
    m_Metadata:
      m_Items: []
  - m_Id: 313253894
    m_Localized: "Visita a un animal y presiona <b>E</b> para acariciarlo. \xA1Los
      animales felices producen m\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 313253895
    m_Localized: "Duerme para avanzar el d\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 313253896
    m_Localized: El tiempo pasa cuando duermes. Camina hasta la <b>cama</b> y presiona
      <b>E</b> para dormir.
    m_Metadata:
      m_Items: []
  - m_Id: 313253897
    m_Localized: Cosecha un cultivo
    m_Metadata:
      m_Items: []
  - m_Id: 313253898
    m_Localized: "\xA1Tus cultivos han crecido! Camina hasta un <b>cultivo listo</b>
      y presiona <b>E</b> o haz clic izquierdo para cosechar."
    m_Metadata:
      m_Items: []
  - m_Id: 313253899
    m_Localized: 'Paso {0}/{1}: {2}'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
