  m_TableData:
  - m_Id: 300670976
    m_Localized: Till the soil
    m_Metadata:
      m_Items: []
  - m_Id: 313253888
    m_Localized: Welcome to your farm! Equip the <b>Hoe</b> from your hotbar, then
      <b>left-click</b> on a soil tile to till it.
    m_Metadata:
      m_Items: []
  - m_Id: 313253889
    m_Localized: Plant a seed
    m_Metadata:
      m_Items: []
  - m_Id: 313253890
    m_Localized: Great! Now equip a <b>Seed</b> and <b>left-click</b> the tilled
      soil to plant it.
    m_Metadata:
      m_Items: []
  - m_Id: 313253891
    m_Localized: Water the crop
    m_Metadata:
      m_Items: []
  - m_Id: 313253892
    m_Localized: Crops need water to grow. Equip the <b>Watering Can</b> and <b>left-click</b>
      the planted soil.
    m_Metadata:
      m_Items: []
  - m_Id: 313253893
    m_Localized: Pet an animal
    m_Metadata:
      m_Items: []
  - m_Id: 313253894
    m_Localized: Visit an animal and press <b>E</b> to pet it. Happy animals produce
      more!
    m_Metadata:
      m_Items: []
  - m_Id: 313253895
    m_Localized: Sleep to advance the day
    m_Metadata:
      m_Items: []
  - m_Id: 313253896
    m_Localized: Time passes when you sleep. Walk to the <b>bed</b> and press <b>E</b>
      to sleep.
    m_Metadata:
      m_Items: []
  - m_Id: 313253897
    m_Localized: Harvest a crop
    m_Metadata:
      m_Items: []
  - m_Id: 313253898
    m_Localized: Your crops have grown! Walk to a <b>ready crop</b> and press <b>E</b>
      or left-click to harvest.
    m_Metadata:
      m_Items: []
  - m_Id: 313253899
    m_Localized: 'Step {0}/{1}: {2}'
    m_Metadata:
      m_Items: []
  - m_Id: 25272196182827008
    m_Localized: Step {0}/{1}
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
