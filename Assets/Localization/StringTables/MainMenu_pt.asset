      m_Items: []
  - m_Id: 296476674
    m_Localized: "Novo Jogo \u2014 Escolha o Slot"
    m_Metadata:
      m_Items: []
  - m_Id: 296476675
    m_Localized: Carregando... {0:P0}
    m_Metadata:
      m_Items: []
  - m_Id: 296476676
    m_Localized: Carregando dados salvos...
    m_Metadata:
      m_Items: []
  - m_Id: 296476677
    m_Localized: Inicializando novo jogo...
    m_Metadata:
      m_Items: []
  - m_Id: 296476678
    m_Localized: Arquivo de Save Encontrado
    m_Metadata:
      m_Items: []
  - m_Id: 296476679
    m_Localized: 'Arquivo: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 296476680
    m_Localized: 'Tamanho: {0}KB'
    m_Metadata:
      m_Items: []
  - m_Id: 296476681
    m_Localized: "\xDAltimo salvamento: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 296476682
    m_Localized: "Painel de configura\xE7\xF5es n\xE3o configurado!"
    m_Metadata:
      m_Items: []
  - m_Id: 296476683
    m_Localized: "Painel de informa\xE7\xF5es de save n\xE3o configurado!"
    m_Metadata:
      m_Items: []
  - m_Id: 296476684
    m_Localized: "Informa\xE7\xF5es do Save\\n\\nArquivo: {0}\\nCriado: {1}\\n\xDAltimo
      salvamento: {2}\\nTamanho: {3}\\n\\n O jogo salva automaticamente quando voc\xEA
      dorme na cama"
    m_Metadata:
      m_Items: []
  - m_Id: 296476685
    m_Localized: "Nenhum arquivo de save encontrado\\n\\nDurma em uma cama para salvar
      seu progresso automaticamente.\\n\\nO jogo criar\xE1 um arquivo de save quando
      voc\xEA dormir pela primeira vez."
    m_Metadata:
      m_Items: []
  - m_Id: 296476686
    m_Localized: "Salvar Jogo \u2014 Escolha o Slot"
    m_Metadata:
      m_Items: []
  - m_Id: 296476687
    m_Localized: "Carregar Jogo \u2014 Escolha o Slot"
    m_Metadata:
      m_Items: []
  - m_Id: 296476688
    m_Localized: Sobrescrever o save em {0}?
    m_Metadata:
      m_Items: []
  - m_Id: 296476689
    m_Localized: "Carregar este save? O progresso n\xE3o salvo ser\xE1 perdido."
    m_Metadata:
      m_Items: []
  - m_Id: 296476690
    m_Localized: Salvo em {0}!
    m_Metadata:
      m_Items: []
  - m_Id: 296476691
    m_Localized: "Sair para a \xC1rea de Trabalho?\\n\\nQualquer progresso n\xE3o
      salvo ser\xE1 perdido.\\nCertifique-se de dormir em uma cama para salvar!"
    m_Metadata:
      m_Items: []
  - m_Id: 296476692
    m_Localized: "Voltar ao Menu Principal?\\n\\nQualquer progresso n\xE3o salvo
      ser\xE1 perdido.\\nCertifique-se de dormir em uma cama para salvar!"
    m_Metadata:
      m_Items: []
  - m_Id: 296476693
    m_Localized: "Excluir Arquivo de Save?\n\nEsta a\xE7\xE3o n\xE3o pode ser desfeita.\nTodo
      o seu progresso ser\xE1 perdido permanentemente!"
    m_Metadata:
      m_Items: []
  - m_Id: 296476694
    m_Localized: "Arquivo de save exclu\xEDdo!"
    m_Metadata:
      m_Items: []
  - m_Id: 296476695
    m_Localized: "Mensagem de notifica\xE7\xE3o de teste!"
    m_Metadata:
      m_Items: []
  - m_Id: 296476696
    m_Localized: Mensagem de erro de teste!
    m_Metadata:
      m_Items: []
  - m_Id: 296476697
    m_Localized: "Voltar ao Menu Principal?\\n\\nQualquer progresso n\xE3o salvo
      ser\xE1 perdido.\\nCertifique-se de salvar o jogo primeiro!"
    m_Metadata:
      m_Items: []
  - m_Id: 296476698
    m_Localized: "Informa\xE7\xF5es do Arquivo de Save:\\n\\nArquivo: {0}\\nCriado:
      {1}\\n\xDAltima Modifica\xE7\xE3o: {2}\\nTamanho: {3}\\n\\n O jogo salva automaticamente
      quando voc\xEA dorme na cama"
    m_Metadata:
      m_Items: []
  - m_Id: 296476699
    m_Localized: "Nenhum arquivo de save encontrado.\\n\\nDurma em uma cama para
      salvar seu progresso automaticamente.\\n\\nO jogo criar\xE1 um arquivo de save
      quando voc\xEA dormir."
    m_Metadata:
      m_Items: []
