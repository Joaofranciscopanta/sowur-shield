  - m_Id: 14872607390949377
    m_Localized: (Dislikes)
    m_Metadata:
      m_Items: []
  - m_Id: 14872607390949378
    m_Localized: 'Requires: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 14872607390949379
    m_Localized: Tastes discovered ({0}/{1})
    m_Metadata:
      m_Items: []
  - m_Id: 14872607390949380
    m_Localized: You haven't learned what they like yet.
    m_Metadata:
      m_Items: []
  - m_Id: 14879358790131712
    m_Localized: Hello there. Good to see a friendly face around here.
    m_Metadata:
      m_Items: []
  - m_Id: 14879358857240576
    m_Localized: Take care out there.
    m_Metadata:
      m_Items: []
