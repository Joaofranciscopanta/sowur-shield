  - m_Id: 2630369969692672
    m_Localized: Trouble in Sunny Fields
    m_Metadata:
      m_Items: []
  - m_Id: 2630369990664192
    m_Localized: Something's been spooking the animals near Sunny Fields. Take your
      team out there and clear it up.
    m_Metadata:
      m_Items: []
  - m_Id: 2630369990664193
    m_Localized: Clear Sunny Fields
    m_Metadata:
      m_Items: []
  - m_Id: 2630369990664194
    m_Localized: Egg Collector
    m_Metadata:
      m_Items: []
  - m_Id: 2630369990664195
    m_Localized: "Your chickens are laying \u2014 collect a few eggs for the pantry."
    m_Metadata:
