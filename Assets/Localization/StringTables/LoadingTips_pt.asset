      m_Items: []
  - m_Id: 321642497
    m_Localized: "Dica: Planta\xE7\xF5es diferentes crescem em esta\xE7\xF5es diferentes."
    m_Metadata:
      m_Items: []
  - m_Id: 321642498
    m_Localized: "Dica: Converse com NPCs para aprender mais sobre t\xE9cnicas de
      cultivo."
    m_Metadata:
      m_Items: []
  - m_Id: 321642499
    m_Localized: "Dica: Melhore suas ferramentas para trabalhar com mais efici\xEAncia."
    m_Metadata:
      m_Items: []
  - m_Id: 321642500
    m_Localized: 'Dica: Salve seu jogo regularmente para evitar perder o progresso.'
